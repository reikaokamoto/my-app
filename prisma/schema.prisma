generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Expense {
  id       Int      @id @default(autoincrement())
  amount   Int
  category String   @db.VarChar(100)
  date     DateTime @db.Date
  memo     String?  @db.Text

  @@map("expenses")
}
